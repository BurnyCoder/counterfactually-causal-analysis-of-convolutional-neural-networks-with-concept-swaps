# Copy to .env and edit. Every value is read by src/concept_swap/config.py (python-dotenv).
# Compute device for PyTorch ("cuda" or "cpu").
DEVICE=cuda
# Directories (relative to the repo root).
DATA_DIR=data
RESULTS_DIR=results
FIGURES_DIR=figures
LOG_DIR=logs
# LRN variant: "tf" = TensorFlow-exact constants (lucent PR #51), "lucent" = Lucent's hardcoded defaults.
LRN_MODE=tf
# Stimulus grid: number of orientations over 360 deg, arc radii (px), line widths (px), arc angular span (deg).
N_THETA=72
RADII=20,30,45,60
WIDTHS=3,5
ARC_SPAN_DEG=120
# Max random translation (px) of each stimulus; splits differ only by this jitter's seed.
JITTER_PX=2
# Seeds: pilot (discarded), selection (fits stats/templates/nulls), confirmatory (all tests), stability re-runs.
PILOT_SEED=0
SELECTION_SEED=1
CONFIRM_SEED=2
STABILITY_SEEDS=3,4
# Minimal-pair design: sources per base and the minimum orientation difference (deg).
SOURCES_PER_BASE=4
MIN_DTHETA=30
# Success tolerance of the orientation decoder (deg).
TOL_DEG=10
# Null-distribution and bootstrap sizes.
N_NULL_SETS=2000
N_BOOT=2000
# GPU batch size for forward passes.
BATCH_SIZE=256
# Imagenette (fast.ai) 320-px archive.
IMAGENETTE_URL=https://s3.amazonaws.com/fast-ai-imageclas/imagenette2-320.tgz
# Rotation angles (deg) for the natural-image counterfactual.
ROTATIONS=-90,-45,45,90,180
